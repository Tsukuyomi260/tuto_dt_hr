# --- Dépendances ---
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# --- Build / sorties ---
dist/
build/
out/
.next/
.expo/
.expo-shared/
*.tsbuildinfo

# --- Mobile (Expo / React Native) ---
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
android/app/build/
ios/Pods/
ios/build/

# --- Variables d'environnement et secrets ---
# Clés API (modèle, WhatsApp Business, base vectorielle) : jamais dans le dépôt.
.env
.env.*
!.env.example
*.pem
credentials.json
service-account*.json

# --- Python (backend / pipeline RAG) ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# --- Index vectoriels et données dérivées ---
# Régénérables depuis les sources : on ne versionne pas les embeddings.
.chroma/
chroma_db/
*.faiss
*.index

# --- Tests / qualité ---
coverage/
.nyc_output/
.pytest_cache/
.ruff_cache/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Outillage local ---
.claude/settings.local.json
.claude/*.local.json
.cache/
.parcel-cache/
.turbo/
.vercel/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Annales et corpus dérivé ---
# Œuvre d'un tiers (DAASSI S. H. Romaric, édition 2025).
#
# Le PDF source reste hors du dépôt. Le corpus dérivé, lui, y entre : Vercel
# construit depuis Git, et la route le lit sur le disque à l'exécution. Sans
# lui, `CORPUS_DISPONIBLE` est faux et le tuteur répond de mémoire, sans
# l'annale et sans que rien ne l'indique au candidat.
#
# ⚠ Cela met le texte d'un tiers dans le dépôt : à réserver à un dépôt privé,
# ou à couvrir par un accord avec l'auteur avant toute publication.
data/annales/*
data/corpus/*
!data/**/.gitkeep
!data/corpus/technologie-hoteliere.md
