# --- Dépendances ---
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# --- Build / sorties ---
dist/
build/
out/
.next/
.expo/
.expo-shared/
*.tsbuildinfo

# --- Mobile (Expo / React Native) ---
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
android/app/build/
ios/Pods/
ios/build/

# --- Variables d'environnement et secrets ---
# Clés API (modèle, WhatsApp Business, base vectorielle) : jamais dans le dépôt.
.env
.env.*
!.env.example
*.pem
credentials.json
service-account*.json

# --- Python (backend / pipeline RAG) ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# --- Index vectoriels et données dérivées ---
# Régénérables depuis les sources : on ne versionne pas les embeddings.
.chroma/
chroma_db/
*.faiss
*.index

# --- Tests / qualité ---
coverage/
.nyc_output/
.pytest_cache/
.ruff_cache/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Outillage local ---
.claude/settings.local.json
.claude/*.local.json
.cache/
.parcel-cache/
.turbo/
.vercel/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
