# Clé Anthropic — côté serveur uniquement.
# Elle ne doit JAMAIS être préfixée NEXT_PUBLIC_ : elle serait alors incluse
# dans le bundle client et lisible par n'importe quel candidat.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle et effort. `medium` est le point de départ recommandé : sur Opus 5,
# les niveaux bas tiennent remarquablement bien et sont le principal levier
# de latence sur réseau lent.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
