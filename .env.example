# Clé Anthropic — côté serveur uniquement.
# Elle ne doit JAMAIS être préfixée NEXT_PUBLIC_ : elle serait alors incluse
# dans le bundle client et lisible par n'importe quel candidat.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle. Deux générations, deux jeux de paramètres — la route s'adapte toute
# seule (voir src/lib/modele.ts), mais il faut savoir lequel s'applique :
#
#   claude-haiku-4-5   le moins cher et le plus rapide. N'accepte NI la
#                      réflexion adaptative NI `ANTHROPIC_EFFORT` : les deux
#                      renvoient un 400. Réflexion réglable par budget de
#                      jetons (voir plus bas), désactivée par défaut.
#   claude-opus-5      le plus capable. Réflexion adaptative + effort.
#   claude-sonnet-5    intermédiaire, mêmes paramètres qu'Opus 5.
ANTHROPIC_MODEL=claude-haiku-4-5

# Effort — modèles 4.6 et suivants uniquement (Opus 5, Sonnet 5).
# Ignoré sur Haiku 4.5, où il provoquerait une erreur s'il était transmis.
ANTHROPIC_EFFORT=medium

# Réflexion sur les modèles antérieurs à 4.6 (Haiku 4.5), en jetons.
# Vide ou 0 : désactivée — c'est le réglage par défaut, l'intérêt de Haiku
# étant la latence et le coût. Minimum imposé par l'API si activée : 1024.
# ANTHROPIC_THINKING_BUDGET=2048
